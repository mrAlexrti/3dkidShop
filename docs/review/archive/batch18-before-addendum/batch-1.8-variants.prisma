// NOT APPROVED FOR PRODUCTION EXECUTION. Review-only candidate; not the application schema.
// Stage 1A.5: no database connection or client generation is authorized by this file.
// Prisma schema — интернет-магазин

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (Auth.js) ----------

enum Role {
  ADMIN
  MANAGER
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String?
  role         Role      @default(MANAGER)
  createdAt    DateTime  @default(now())
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Каталог ----------

model Category {
  id          String     @id @default(cuid())
  name        String
  nameEn      String
  slug        String     @unique
  description String?
  imageUrl    String?
  order       Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())

  @@index([parentId])
}

model Product {
  id            String             @id @default(cuid())
  name          String
  nameEn        String?
  slug          String             @unique
  description   String             @db.Text
  descriptionEn String?            @db.Text
  hoverGifUrl   String?
  price         Decimal            @db.Decimal(10, 2)
  oldPrice      Decimal?           @db.Decimal(10, 2)
  sku           String?            @unique
  stock         Int                @default(0) // Deprecated: compatibility/migration only; remove after verified rollout.
  isFeatured    Boolean            @default(false)
  isNew         Boolean            @default(false)
  isActive      Boolean            @default(true)
  isOrderable   Boolean            @default(false)
  categoryId    String
  category      Category           @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  options       ProductOption[]
  attributes    ProductAttribute[]
  orderItems    OrderItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([categoryId])
  optionMode      ProductOptionMode @default(LEGACY)
  variantRevision Int               @default(0)
  variants        ProductVariant[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int     @default(0)
}

// Опции товара, напр. "Размер" -> ["10cm","15cm"], "Материал" -> ["Глянец","Матовый"]
model ProductOption {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  values    ProductOptionValue[]
  kind              ProductOptionKind?
  variantSelections ProductVariantSelection[]
  @@unique([productId, id])
  @@unique([productId, kind])
}

model ProductOptionValue {
  id            String        @id @default(cuid())
  optionId      String
  option        ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value         String
  valueEn       String?
  price         Decimal?      @db.Decimal(10, 2)
  note          String?
  noteEn        String?
  priceModifier Decimal       @default(0) @db.Decimal(10, 2)
  retiredAt         DateTime?
  variantSelections ProductVariantSelection[]
  @@unique([optionId, id])
}

// Характеристики товара (ключ-значение), напр. "Материал" / "Винил"
model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String
}

// ---------- Отзывы ----------

model Review {
  id        String   @id @default(cuid())
  author    String
  rating    Int
  text      String   @db.Text
  avatarUrl String?
  createdAt DateTime @default(now())
}

// ---------- Заказы ----------

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  PAID
  COMPLETED
  CANCELLED
}

enum CheckoutAcceptance {
  LEGACY
  PROVISIONAL
  ACCEPTED
  REVIEW
}

model Order {
  id                      String      @id @default(cuid())
  number                  String?     @unique
  checkoutAcceptance      CheckoutAcceptance @default(LEGACY)
  acceptedAt              DateTime?
  paymentReference        String?     @unique
  checkoutKeyHash         String?     @unique
  checkoutPayloadHash     String?
  checkoutLocale          String?
  paymentPageUrl          String?     @db.Text
  notifications           OrderNotification[]
  status                  OrderStatus @default(PENDING)
  customerName            String
  customerFirstName       String?
  customerLastName        String?
  customerEmail           String
  customerPhone           String
  shippingAddress         String
  deliveryMethod          String?
  city                    String
  postalCode              String
  novaPoshtaCity          String?
  novaPoshtaCityRef       String?
  novaPoshtaBranch        String?
  novaPoshtaBranchRef     String?
  comment                 String?
  paymentMethod           String
  paymentProvider         String?
  paymentMode             String?
  paymentStatus           String?
  paidAt                  DateTime?
  paymentInvoiceId        String?
  paymentProviderStatus   String?
  paymentModifiedAt       DateTime?
  paymentExpiresAt        DateTime?
  paymentNextCheckAt      DateTime?
  paymentErrorCode        String?
  subtotal                Decimal     @db.Decimal(10, 2)
  shippingCost            Decimal     @default(0) @db.Decimal(10, 2)
  total                   Decimal     @db.Decimal(10, 2)
  novaPoshtaTtn           String?
  novaPoshtaTtnRef        String?
  novaPoshtaStatus        String?
  novaPoshtaStatusCode    String?
  novaPoshtaCreatedAt     DateTime?
  novaPoshtaSyncedAt      DateTime?
  novaPoshtaDeliveredAt   DateTime?
  novaPoshtaCodStatus     String?
  novaPoshtaCodStatusCode String?
  novaPoshtaCodAmount     Decimal?    @db.Decimal(10, 2)
  novaPoshtaError         String?
  items                   OrderItem[]
  createdAt               DateTime    @default(now())

  @@unique([paymentProvider, paymentInvoiceId])
  @@index([paymentProvider, paymentNextCheckAt])
  @@index([checkoutAcceptance, createdAt])
}

model OrderNotification {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  event             String
  channel           String
  state             String   @default("PENDING")
  payload           Json
  attemptCount      Int      @default(0)
  nextAttemptAt     DateTime? @default(now())
  dispatchId        String?
  leaseUntil        DateTime?
  providerMessageId String?
  lastErrorCode     String?
  createdAt         DateTime @default(now())
  sentAt            DateTime?

  @@unique([orderId, event, channel])
  @@index([state, nextAttemptAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  optionsJson String? // JSON-строка выбранных опций
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productId, productVariantId], references: [productId, id], onDelete: Restrict, onUpdate: Restrict)
  @@index([productId, productVariantId])
}

// ---------- Контент сайта (управляется из админки) ----------

model SiteContent {
  id    String @id @default(cuid())
  key   String @unique // напр. "hero_title", "hero_subtitle", "hero_image"
  value String @db.Text
}

enum ProductOptionMode {
  LEGACY
  SIMPLE
  SIZE
  COLOR
  COLOR_SIZE
}

enum ProductOptionKind {
  COLOR
  SIZE
}

model ProductVariant {
  id             String                    @id @default(cuid())
  productId      String
  product        Product                   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  combinationKey String                    @db.VarChar(300)
  price          Decimal                   @db.Decimal(10, 2)
  isAvailable    Boolean                   @default(false)
  retiredAt      DateTime?
  selections     ProductVariantSelection[]
  orderItems     OrderItem[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([productId, id])
  @@unique([productId, combinationKey])
  @@index([productId, retiredAt, isAvailable])
}

model ProductVariantSelection {
  variantId String
  productId String
  optionId  String
  valueId   String
  variant   ProductVariant     @relation(fields: [productId, variantId], references: [productId, id], onDelete: Cascade, onUpdate: Restrict)
  option    ProductOption      @relation(fields: [productId, optionId], references: [productId, id], onDelete: NoAction, onUpdate: Restrict)
  value     ProductOptionValue @relation(fields: [optionId, valueId], references: [optionId, id], onDelete: NoAction, onUpdate: Restrict)

  @@id([variantId, optionId])
  @@index([optionId, valueId])
  @@index([productId, variantId])
}
